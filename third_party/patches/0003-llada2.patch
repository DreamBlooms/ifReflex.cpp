--- /dev/null
+++ b/conversion/llada2.py
@@ -0,0 +1,77 @@
+from __future__ import annotations
+
+import json
+
+from .base import ModelBase, gguf
+from .bailingmoe import BailingMoeV2Model
+
+
+@ModelBase.register("LLaDA2MoeModelLM")
+@ModelBase.example("inclusionAI/LLaDA2.2-mini")
+class LLaDA2MoeModel(BailingMoeV2Model):
+    # LLaDA 2.x shares the BailingMoeV2 graph; it only adds mask-token,
+    # non-causal diffusion behaviour on top.
+    model_arch = gguf.MODEL_ARCH.LLADA2
+
+    def get_vocab_base(self) -> tuple[list[str], list[int], str]:
+        # The LLaDA2 tokenizer ships as custom remote code, so it must be
+        # loaded with trust_remote_code (same as the LLaDA 1.x converter).
+        tokens: list[str] = []
+        toktypes: list[int] = []
+
+        from transformers import AutoTokenizer
+        tokenizer = AutoTokenizer.from_pretrained(self.dir_model, trust_remote_code=True)
+
+        vocab_dict = tokenizer.get_vocab()
+        vocab_size = self.hparams.get("vocab_size", len(vocab_dict))
+        assert max(vocab_dict.values()) < vocab_size
+
+        tokpre = self.get_vocab_base_pre(tokenizer)
+
+        reverse_vocab = {id_: encoded_tok for encoded_tok, id_ in vocab_dict.items()}
+        added_vocab = tokenizer.get_added_vocab()
+
+        for i in range(vocab_size):
+            if i not in reverse_vocab:
+                tokens.append(f"[PAD{i}]")
+                toktypes.append(gguf.TokenType.UNUSED)
+            elif reverse_vocab[i] in added_vocab:
+                tokens.append(reverse_vocab[i])
+                if hasattr(tokenizer, "added_tokens_decoder") and i in tokenizer.added_tokens_decoder:
+                    if tokenizer.added_tokens_decoder[i].special:
+                        toktypes.append(gguf.TokenType.CONTROL)
+                    else:
+                        toktypes.append(gguf.TokenType.USER_DEFINED)
+                else:
+                    toktypes.append(gguf.TokenType.CONTROL)
+            else:
+                tokens.append(reverse_vocab[i])
+                toktypes.append(gguf.TokenType.NORMAL)
+
+        return tokens, toktypes, tokpre
+
+    def mask_token_id(self) -> int | None:
+        # LLaDA2.x releases differ: some expose the id in the config, others only the token.
+        if (mask_id := self.hparams.get("mask_token_id")) is not None:
+            return int(mask_id)
+        path = self.dir_model / "tokenizer_config.json"
+        if not path.is_file():
+            return None
+        with open(path, encoding="utf-8") as f:
+            cfg = json.load(f)
+        for tid, tok in cfg.get("added_tokens_decoder", {}).items():
+            if tok.get("content") == "<|mask|>":
+                return int(tid)
+        return None
+
+    def set_gguf_parameters(self):
+        super().set_gguf_parameters()
+        self.gguf_writer.add_causal_attention(False)
+        self.gguf_writer.add_diffusion_shift_logits(False)
+        if (mask_id := self.mask_token_id()) is not None:
+            self.gguf_writer.add_mask_token_id(mask_id)
+        # Levenshtein edit control tokens (DELETE/INSERT), consumed by the diffusion sampler.
+        if (delete_id := self.hparams.get("delete_token_id")) is not None:
+            self.gguf_writer.add_uint32("diffusion.delete_token_id", int(delete_id))
+        if (split_id := self.hparams.get("split_token_id")) is not None:
+            self.gguf_writer.add_uint32("diffusion.split_token_id", int(split_id))
